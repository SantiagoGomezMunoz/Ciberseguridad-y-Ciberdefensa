PORT=3000
DATABASE_URL=postgresql://banco_user:cambia_esta_clave@localhost:5432/banco_db
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia_este_secreto  # mínimo 32 caracteres
# true solo cuando se sirva por HTTPS (detrás de Nginx/Apache)
COOKIE_SECURE=false
TRUST_PROXY=false

# HTTPS (opcional): al definir SSL_KEY y SSL_CERT la app sirve por HTTPS y activa cookie Secure + HSTS
#SSL_KEY=certs/key.pem
#SSL_CERT=certs/cert.pem
#HTTP_REDIRECT_PORT=8080
