<%- include('partials/header') %>
<h1>Hola, <%= user.nombre %></h1>
<section>
  <h2>Cuenta de <%= cuenta.tipo %></h2>
  <p>Número: <strong><%= cuenta.numero %></strong></p>
  <p>Saldo disponible: <strong class="saldo"><%= cop(cuenta.saldo) %></strong></p>
  <p><a class="btn" href="/transferir">Hacer una transferencia</a></p>
</section>
<section>
  <h2>Últimos movimientos</h2>
  <%- include('partials/tabla', { items: ultimos }) %>
  <p><a href="/movimientos">Ver todos los movimientos</a></p>
</section>
<%- include('partials/footer') %>
