<%- include('partials/header') %>
<h1>Hola, <%= user.nombre %></h1>
<p class="sub">Este es el resumen de tu cuenta.</p>
<section class="balance">
  <div>
    <p class="label">Saldo disponible · cuenta de <%= cuenta.tipo %></p>
    <p class="amount"><%= cop(cuenta.saldo) %></p>
    <p class="acct">N.º <%= cuenta.numero %></p>
  </div>
  <a class="btn" href="/transferir">Hacer una transferencia</a>
</section>
<section class="card">
  <h2>Últimos movimientos</h2>
  <%- include('partials/tabla', { items: ultimos }) %>
  <p style="margin:1rem 0 0"><a href="/movimientos">Ver todos los movimientos</a></p>
</section>
<%- include('partials/footer') %>
